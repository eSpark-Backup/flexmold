<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<TargetFramework>net6.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>flexmold.ico</ApplicationIcon>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>
	<ItemGroup>
		<Resource Include="flexmold.ico">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Nlog.config">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>
	<ItemGroup>
		<None Update="External Libs\ToastNotifications.dll">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="External Libs\ToastNotifications.Messages.dll">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="Nlog.config">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="NLog.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Font\" />
		<Folder Include="images\" />
		<Folder Include="MVVM\ViewModel\Accessory\" />
		<Folder Include="MVVM\View\Diaglog\" />
		<Folder Include="Common\" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\NlogViewer\NlogViewer.csproj" />
		<ProjectReference Include="..\ScriptingTestContainerBase\ScriptingTestContainerBase.csproj" />
	</ItemGroup>
	<ItemGroup>
		<COMReference Include="TCatSysManagerLib">
			<WrapperTool>tlbimp</WrapperTool>
			<VersionMinor>3</VersionMinor>
			<VersionMajor>3</VersionMajor>
			<Guid>3c49d6c3-93dc-11d0-b162-00a0248c244b</Guid>
			<Lcid>0</Lcid>
			<Isolated>false</Isolated>
			<EmbedInteropTypes>true</EmbedInteropTypes>
		</COMReference>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Beckhoff.TwinCAT.Ads" Version="6.0.249" />
		<PackageReference Include="DataGridExtensions" Version="2.5.14" />
		<PackageReference Include="envdte80" Version="17.5.33428.366" />
		<PackageReference Include="Humanizer" Version="2.14.1" />
		<PackageReference Include="MahApps.Metro" Version="2.4.9" />
		<PackageReference Include="MahApps.Metro.IconPacks" Version="4.11.0" />
		<PackageReference Include="MaterialDesignThemes.MahApps" Version="0.2.8" />
		<PackageReference Include="Microsoft.CodeCoverage" Version="17.5.0" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="NLog.Schema" Version="5.1.3" />
		<PackageReference Include="ShowMeTheXAML" Version="2.0.0" />
		<PackageReference Include="SMBLibrary" Version="1.4.9" />
		<PackageReference Include="StructPacker" Version="1.0.8" />
		<PackageReference Include="Sylvan.Data.Csv" Version="1.2.7" />
		<PackageReference Include="System.Runtime.InteropServices.WindowsRuntime" Version="4.3.0" />
		<PackageReference Include="Microsoft.DotNet.UpgradeAssistant.Extensions.Default.Analyzers" Version="0.4.410601">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<Reference Include="ToastNotifications">
			<HintPath>External Libs\ToastNotifications.dll</HintPath>
		</Reference>
		<Reference Include="ToastNotifications.Messages">
			<HintPath>External Libs\ToastNotifications.Messages.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>
</Project>