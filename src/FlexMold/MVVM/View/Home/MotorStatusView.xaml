<UserControl
    x:Class="FlexMold.MVVM.View.Home.MotorStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Home"
    xmlns:home="clr-namespace:FlexMold.MVVM.ViewModel.Home" d:DataContext="{d:DesignInstance Type=home:MotorStatusViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <DockPanel>
        <!-- Dock Panel is added additionally-->
        <!-- Calibrate button is now docked at the bottom -->
        <Button
            Content="Calibrate"
            Command="{Binding CompleteCalibrateCommand}"
            IsEnabled="{Binding CalibrateButtonEnable}"
            MaxHeight="40"
            MaxWidth="120"
            Margin="10"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom" />

        <!-- Motor Grid inside a newly createdd scrollable area -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl
                x:Name="MyItems"
                ItemsSource="{Binding MyMotors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding BoundedRow}" Columns="{Binding BoundedColumn}"/>
                        <!--Here is where you can edit and establish the number of rows or columns. NOTE: if row is 1, and column is 1, "the motors will overlap!"-->
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock
                                Text="{Binding MotorID}"
                                FontSize="10"
                                FontFamily="Times New Roman"
                                FontWeight="Normal"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,2"/>
                            <Button
                                Width="50"
                                Height="50"
                                Background="{Binding FillColor}"
                                BorderBrush="{Binding StrokeColor}"
                                
                                Command="{Binding DataContext.DebugDetailClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding ToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse
                                                Fill="{TemplateBinding Background}"
                                                Stroke="{TemplateBinding BorderBrush}"
                                                StrokeThickness="5" />
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RecognizesAccessKey="True" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Content>
                                    <TextBlock
                                        Text="{Binding MotorPosition, StringFormat={}{0:0}}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>