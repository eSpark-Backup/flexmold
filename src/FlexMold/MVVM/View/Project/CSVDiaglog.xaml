<UserControl
    x:Class="FlexMold.MVVM.View.Project.CSVDiaglog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convertor="clr-namespace:FlexMold.Convertor"
    xmlns:core="clr-namespace:FlexMold.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Project"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    mc:Ignorable="d">
    <UserControl.Resources>
        <convertor:RadioBoolToIntConverter x:Key="radioBoolToIntConverter" />
    </UserControl.Resources>
    <Border Style="{StaticResource panelMenuBorder}">
        <UniformGrid Rows="3">
            <Label
                HorizontalAlignment="Center"
                Content="Please Select Motor Direction"
                TextBlock.TextAlignment="Center" />
            <UniformGrid Columns="2">
                <RadioButton
                    Content="Clockwise"
                    GroupName="g1"
                    IsChecked="{Binding SelectedMotorDirPValue, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=0}" />
                <RadioButton
                    Content="Anti-Clockwise"
                    GroupName="g1"
                    IsChecked="{Binding SelectedMotorDirPValue, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=1}" />
            </UniformGrid>
            <Button Command="{x:Static wpf:DialogHost.CloseDialogCommand}" IsCancel="True">
                <Button.CommandParameter>
                    <system:Boolean>False</system:Boolean>
                </Button.CommandParameter>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Margin="6" Kind="Cancel" />
                    <TextBlock VerticalAlignment="Center" Text="Close" />
                </StackPanel>
            </Button>
        </UniformGrid>
    </Border>
</UserControl>