<UserControl
    x:Class="FlexMold.MVVM.View.Project.ProjectGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convertor="clr-namespace:FlexMold.Convertor"
    xmlns:core="clr-namespace:FlexMold.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Project"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:FlexMold.MVVM.Model"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel"
    d:DesignHeight="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <convertor:DistinctConverter x:Key="distinctConverter" />
        <CollectionViewSource x:Key="cvsTasks" Source="{Binding myDataModels}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="PorjectName" />
                <scm:SortDescription PropertyName="Panel" />
                <scm:SortDescription PropertyName="Complete" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="ProjectName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <ControlTemplate x:Key="MultipleChoiceFilter">
            <core:MultipleChoiceFilter Filter="{Binding Path=Filter, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dgx:DataGridFilterColumnControl}}" />
        </ControlTemplate>
        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="350" />
        </Grid.RowDefinitions>
        <!--  IsSynchronizedWithCurrentItem="True"  -->
        <DataGrid
            x:Name="dataGrid1"
            Grid.Row="1"
            Margin="5"
            dgx:DataGridFilter.IsAutoFilterEnabled="True"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding Source={StaticResource cvsTasks}}"
            RowHeaderWidth="20"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding Path=selectedMyDataModel}"
            SelectionUnit="FullRow">
            <DataGrid.Resources>
               
            </DataGrid.Resources>
            <DataGrid.GroupStyle>
                <!--  Style for groups at top level.  -->
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,5" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander
                                            IsExpanded="False">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <TextBlock
                                                        Width="100"
                                                        Margin="5,0,0,0"
                                                        FontSize="15"
                                                        Text="{Binding Path=Name}" />
                                                    <TextBlock
                                                        FontSize="15"
                                                        Text="{Binding Path=ItemCount}" />
                                                </DockPanel>
                                            </Expander.Header>
                                            <Expander.Content>
                                                <ItemsPresenter />
                                            </Expander.Content>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
                <!--  Style for groups under the top level.  -->
            </DataGrid.GroupStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="FontSize" Value="13" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn
                    dgx:DataGridFilterColumn.Template="{StaticResource MultipleChoiceFilter}"
                    Binding="{Binding ProjectName}"
                    Header="Project" />
                <DataGridTextColumn
                    dgx:DataGridFilterColumn.Template="{StaticResource MultipleChoiceFilter}"
                    Binding="{Binding Panel}"
                    Header="Panel" />
                <DataGridCheckBoxColumn Binding="{Binding Complete}" Header="Complete" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MahApps.Styles.DataGridRow}" TargetType="{x:Type DataGridRow}">
                    <Setter Property="FontSize" Value="14" />
                    <Style.Triggers>
                        <!--  IsMouseOver  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#FF53DEF5" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Style>
                <Style BasedOn="{StaticResource MahApps.Styles.DataGrid}" TargetType="{x:Type DataGrid}">
                    <Setter Property="AlternatingRowBackground" Value="{DynamicResource MahApps.Brushes.Gray9}" />
                </Style>
            </DataGrid.Style>
        </DataGrid>
        
            <CheckBox
                VerticalAlignment="Center"
                Checked="GroupButton_Click"
                Content="Groups"
                IsChecked="True"
                Unchecked="UngroupButton_Click" />
    </Grid>
</UserControl>
