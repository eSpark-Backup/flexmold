<UserControl
    x:Class="FlexMold.MVVM.View.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convertor="clr-namespace:FlexMold.Convertor"
    xmlns:core="clr-namespace:FlexMold.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold.MVVM.View"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:project="clr-namespace:FlexMold.MVVM.View.Project"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel"
    Name="parent"
    d:DataContext=""
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <viewmodel:ProjectViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <convertor:HeightConverter x:Key="HeightConverter" />
        <convertor:BoolInverterConverter x:Key="BoolInverterConverter" />
    </UserControl.Resources>
    <Border Style="{StaticResource panelMenuBorder}">
        <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="190*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Grid.Column="0"
                Margin="8,0,0,0"
                Header="Projects Selection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        Name="btProjectBrowse"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Command="{Binding BrowseProjectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Margin="6" Kind="Folder" />
                            <TextBlock VerticalAlignment="Center" Text="Browse Project" />
                        </StackPanel>
                    </Button>
                    <project:ProjectGridView
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Available Files(Selected Panel)">
                <DockPanel>
                    <!--    -->
                    <DataGrid
                        Margin="5"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        DockPanel.Dock="Top"
                        IsReadOnly="True"
                        ItemsSource="{Binding selectedMyDataModel.LaserFile}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding Path=slectedFile}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Header="File" />
                            <DataGridTextColumn Binding="{Binding Length}" Header="Size(b)" />
                            <DataGridTextColumn Binding="{Binding LastWriteTime}" Header="Last Modified" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
            <StackPanel Grid.Column="2" Orientation="Vertical">
                <GroupBox Margin="0,0,8,0" Header="Motor Sensor Chart Info">


                    <StackPanel Orientation="Vertical">
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontSize="14" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontSize="14"
                            Text="Motor Max Travel" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="0"
                            FontSize="14"
                            Text="Travel Time : 1min 20sec" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="Set Time" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Margin="0,0,8,0" Header="Projector Controls">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                            <RadioButton
                                Grid.Row="0"
                                Content="Serial  "
                                GroupName="Group1"
                                IsChecked="{Binding IsSerialMode}" />
                            <RadioButton
                                 Grid.Row="1"
                                Content="Samba "
                                GroupName="Group1"
                                IsChecked="{Binding IsSerialMode, Converter={StaticResource BoolInverterConverter}}" />
                            <Button 
                                Grid.Column="1" 
                                Grid.RowSpan="2"
                                Command="{Binding SendLasFileCommand}" Content="Send Las File" />
                    </Grid>
                </GroupBox>
                <GroupBox Margin="0,0,8,0" Header="Motor Sensor Controls">
                    <StackPanel>
                        <Button Command="{Binding ReadCSVFileCommand}" Content="Read Csv File" />
                        <Button Content="Shape A" />
                        <Button Content="Shape B" />
                        <Button Content="Stop" />
                        <Button Content="Home" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
