<UserControl
    x:Class="FlexMold.MVVM.View.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
    xmlns:convertor="clr-namespace:FlexMold.Convertor"
    xmlns:core="clr-namespace:FlexMold.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold.MVVM.View"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:projectview="clr-namespace:FlexMold.MVVM.View.Project"
    xmlns:projectvm="clr-namespace:FlexMold.MVVM.ViewModel.Project"
    Name="parent"
    Dialog:DialogParticipation.Register="{Binding}"
    d:DataContext=""
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <projectvm:ProjectViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <convertor:RadioBoolToIntConverter x:Key="radioBoolToIntConverter" />

        <convertor:HeightConverter x:Key="HeightConverter" />
        <convertor:BoolInverterConverter x:Key="BoolInverterConverter" />
    </UserControl.Resources>
    <Border Style="{StaticResource panelMenuBorder}">
        <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Grid.Column="0"
                Margin="8,0,0,0"
                Header="Projects Selection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        Name="btProjectBrowse"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Command="{Binding BrowseProjectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Margin="6" Kind="Folder" />
                            <TextBlock VerticalAlignment="Center" Text="Browse Project" />
                        </StackPanel>
                    </Button>
                    <projectview:ProjectGridView
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Available Files(Selected Panel)">
                <DataGrid
                    Margin="5"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding selectedMyDataModel.LaserFile}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding Path=slectedFile}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="File" />
                        <DataGridTextColumn Binding="{Binding Length}" Header="Size(b)" />
                        <DataGridTextColumn Binding="{Binding LastWriteTime}" Header="Last Modified" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <StackPanel Grid.Column="2" Orientation="Vertical">
                <GroupBox Margin="0,0,8,0" Header="Projector Controls">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <UniformGrid
                            Grid.ColumnSpan="3"
                            Columns="3"
                            Rows="2">
                            <RadioButton
                                Margin="5,0,0,0"
                                Content="Serial"
                                GroupName="Group1"
                                IsChecked="{Binding LaserProjectorComMode, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=0}" />
                            <RadioButton
                                Margin="5,0,0,0"
                                Content="Samba"
                                GroupName="Group1"
                                IsChecked="{Binding LaserProjectorComMode, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=1}" />
                            <RadioButton
                                Margin="5,0,0,0"
                                Content="TelNet"
                                GroupName="Group1"
                                IsChecked="{Binding LaserProjectorComMode, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=2}" />

                            <Button
                                Margin="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Command="{Binding SerialConfigCommand}">
                                <StackPanel Orientation="Vertical">
                                    <iconPacks:PackIconForkAwesome Foreground="White" Kind="Bars" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Command="{Binding SambaConfigCommand}">
                                <StackPanel Orientation="Vertical">
                                    <iconPacks:PackIconForkAwesome Foreground="White" Kind="Bars" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Command="{Binding SambaConfigCommand}">
                                <StackPanel Orientation="Vertical">
                                    <iconPacks:PackIconForkAwesome Foreground="White" Kind="Bars" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Button Grid.Row="1" Command="{Binding SendLasFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Margin="6" Kind="Send" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Send Las File"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>

                    </Grid>
                </GroupBox>

                <GroupBox Margin="0,0,8,0" Header="Motor Sensor Chart Info">
                    <StackPanel Orientation="Vertical">
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="Motor Max Travel" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Travel Time : 1min 20sec" />
                        <Button Grid.Row="2" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Margin="6" Kind="Clock" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Set Time"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </GroupBox>
                <GroupBox Margin="0,0,8,0" Header="Motor Sensor Controls">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Command="{Binding ReadCSVFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Margin="6" Kind="SmartCardReader" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Read CSV"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Shape A" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Shape B" />
                        <Button Grid.Row="1" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Margin="6" Kind="StopCircle" />
                                <TextBlock Text="Stop" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Margin="6" Kind="Home" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Home"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
