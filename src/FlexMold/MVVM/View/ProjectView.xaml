<UserControl
    x:Class="FlexMold.MVVM.View.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold.MVVM.View"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <viewmodel:ProjectViewModel />
    </UserControl.DataContext>
    <Border Background="#33577f" CornerRadius="20">
        <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Projects Selection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button
                        Name="btProjectBrowse"
                        Grid.Row="0"
                        Click="btProjectBrowse_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Margin="6" Kind="Folder" />
                            <TextBlock VerticalAlignment="Center" Text="Browse Project" />
                        </StackPanel>
                    </Button>
                    <mah:DropDownButton
                        Grid.Row="1"
                        Content="Projects"
                        DisplayMemberPath="Name">
                        <mah:DropDownButton.Icon>
                            <iconPacks:PackIconMaterial Margin="6" Kind="Projector" />
                        </mah:DropDownButton.Icon>
                    </mah:DropDownButton>
                    <TreeView Name="FolderView" Grid.Row="3">
                        <TreeViewItem Header="Test Shapes">
                            <TreeViewItem Header="Flat 400" />
                            <TreeViewItem Header="Flat 200" />
                            <TreeViewItem Header="Flat 100" />
                        </TreeViewItem>
                        <TreeViewItem Header="X43 2022">
                            <TreeViewItem Header="1A" />
                            <TreeViewItem Header="1AP2" />
                            <TreeViewItem Header="1AS1" />
                            <TreeViewItem Header="1AS2" />
                        </TreeViewItem>
                    </TreeView>
                </Grid>
            </GroupBox>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="2,0,2,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent" />
            <GroupBox Grid.Column="2" Header="Available Panels">
                <ScrollViewer>
                    <TreeView>
                        <TreeViewItem Header="1A">
                            <TreeViewItem Header="1A.csv" />
                            <TreeViewItem Header="Edges.las" />
                            <TreeViewItem Header="EdgesOff20.las" />
                            <TreeViewItem Header="FootprintOff20.las" />
                        </TreeViewItem>
                    </TreeView>
                </ScrollViewer>
            </GroupBox>
            <GridSplitter
                Grid.Column="3"
                Width="3"
                Margin="2,0,2,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent" />
            <StackPanel Grid.Column="4" Orientation="Vertical">
                <GroupBox Header="Motor Sensor Chart Info">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="Panel Text Here" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="Motor Max Travel" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Travel Time : 1min 20sec" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="Set Time" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="Motor Sensor Controls">
                    <StackPanel>
                        <Button Content="Shape A" />
                        <Button Content="Shape B" />
                        <Button Content="Stop" />
                        <Button Content="Home" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
