<UserControl
    x:Class="FlexMold.MVVM.View.Setting.LaserProjectorSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel.Setting"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <viewmodel:LaserProjectorSettingViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label
            Grid.Row="0"
            Grid.Column="0"
            Content="Laser Projector IP" />
        <Label
            Grid.Row="1"
            Grid.Column="0"
            Content="Laser Projector Port" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Text="{Binding LP.IpAddres}" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Text="{Binding LP.TelnetPort}" />
        <TextBox
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Width="380"
            Height="100"
            Text="{Binding SendMessage}" />
        <TextBox
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Width="380"
            Height="100"
            Text="{Binding ReceivedMessage}" />
        <Button
            Grid.Row="4"
            Grid.Column="0"
            Command="{Binding TelnetConnectCommand}"
            Content="Connect" />
        <Button
            Grid.Row="4"
            Grid.Column="1"
            Command="{Binding TelnetDisConnectCommand}"
            Content="Disconnect" />
        <Button
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Content="Save Setting" />

    </Grid>
</UserControl>
