<UserControl
    x:Class="FlexMold.MVVM.View.Setting.DeviceScanDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:FlexMold.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Setting"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spc="clr-namespace:FlexMold.MVVM.View.SplashScreen"
    xmlns:splashscreen="clr-namespace:FlexMold.MVVM.ViewModel.SplashScreen"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    Width="780"
    Height="580"
    d:DataContext="{d:DesignInstance Type=splashscreen:DeviceScanDialogViewModel}"
    mc:Ignorable="d">
    <Border Style="{StaticResource panelMenuBorder}">
        <Grid>
            <Grid.Resources />
            <Grid.RowDefinitions>
                <RowDefinition Height="460" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <spc:DevicesGridView />
            <mah:MetroProgressBar
                Grid.Row="2"
                Margin="10"
                Value="{Binding OverAllProgress}" />
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{Binding DeviceStatusIndex}"
                TextAlignment="Center" />
            <Grid Grid.Row="1">
                <Grid.Resources />
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,5,0,0"
                    Content="File Path"
                    FontSize="15" />
                <Label
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="0,5,0,0"
                    Content="Password"
                    FontSize="15" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="20"
                    Margin="2"
                    MaxLength="12">
                    <TextBox.Text>
                        <Binding Path="Foe_sPathName">
                            <Binding.ValidationRules>
                                <core:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="25"
                    Height="25"
                    HorizontalAlignment="Right"
                    Command="{Binding BrowseFirmwareCommand}"
                    Content=".." />
                <TextBox
                    Name="pbox_pwd"
                    Grid.Row="0"
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Height="20"
                    mah:TextBoxHelper.ClearTextButton="True">
                    <TextBox.Text>
                        <Binding Path="Foe_dwPass">
                            <Binding.ValidationRules>
                                <core:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <UniformGrid
                    Grid.Row="0"
                    Grid.Column="6"
                    Rows="1">
                    <Button
                        Width="125"
                        Height="35"
                        Margin="0,2,3,0"
                        Command="{Binding UpdateFirmwareCommand}"
                        Foreground="Black"
                        IsDefault="True"
                        IsEnabled="{Binding BT_FirmwareEnable}">
                        <Button.CommandParameter>
                            <system:Boolean>True</system:Boolean>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Margin="6" Kind="ContentSave" />
                            <TextBlock
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                Text="Update Firmware" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="125"
                        Height="35"
                        Margin="0,2,3,0"
                        Command="{x:Static wpf:DialogHost.CloseDialogCommand}"
                        Foreground="Black"
                        IsCancel="True"
                        IsEnabled="{Binding BT_FirmwareEnable}">
                        <Button.CommandParameter>
                            <system:Boolean>False</system:Boolean>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Margin="6" Kind="Cancel" />
                            <TextBlock VerticalAlignment="Center" Text="Close" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>