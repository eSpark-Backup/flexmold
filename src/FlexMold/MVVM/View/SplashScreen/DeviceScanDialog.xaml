<UserControl
    x:Class="FlexMold.MVVM.View.Setting.DeviceScanDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:FlexMold.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Setting"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spc="clr-namespace:FlexMold.MVVM.View.SplashScreen"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    Width="780"
    Height="580"
    mc:Ignorable="d">
    <Border Style="{StaticResource panelMenuBorder}">
        <Grid>
            <Grid.Resources />
            <Grid.RowDefinitions>
                <RowDefinition Height="460" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <spc:DevicesGridView />
            <mah:MetroProgressBar
                Grid.Row="2"
                Margin="10"
                Value="{Binding OverAllProgress}" />
            <Grid
                Grid.Row="1"
                Margin="5,0,5,0"
                Background="Red">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="File Path" />
                <TextBox
                    Grid.Column="1"
                    Margin="4"
                    MaxLength="12">
                    <TextBox.Text>
                        <Binding Path="MyFoe.Foe_sPathName">
                            <Binding.ValidationRules>
                                <core:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <Button
                    Grid.Column="2"
                    Width="25"
                    HorizontalAlignment="Right"
                    Command="{Binding BrowseFirmwareCommand}"
                    Content=".." />
                <Label Grid.Column="3" Content="Password" />
                <TextBox
                    Name="pbox_pwd"
                    Grid.Column="4"
                    Width="120"
                    mah:TextBoxHelper.ClearTextButton="True">
                    <TextBox.Text>
                        <Binding Path="MyFoe.Foe_dwPass">
                            <Binding.ValidationRules>
                                <core:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <Button
                    Grid.Column="5"
                    Command="{Binding UpdateFirmwareCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding BT_FirmwareEnable}">
                    <Button.CommandParameter>
                        <system:Boolean>True</system:Boolean>
                    </Button.CommandParameter>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Margin="6" Kind="ContentSave" />
                        <TextBlock VerticalAlignment="Center" Text="Update Firmware" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="6"
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}"
                    IsCancel="True"
                    IsEnabled="{Binding BT_FirmwareEnable}">
                    <Button.CommandParameter>
                        <system:Boolean>False</system:Boolean>
                    </Button.CommandParameter>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Margin="6" Kind="Cancel" />
                        <TextBlock VerticalAlignment="Center" Text="Close" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>