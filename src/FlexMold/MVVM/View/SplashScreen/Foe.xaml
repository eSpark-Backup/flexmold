<UserControl
    x:Class="FlexMold.MVVM.View.SplashScreen.Foe"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:FlexMold.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.SplashScreen"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spc="clr-namespace:FlexMold.MVVM.View.SplashScreen"
    xmlns:splashscreen="clr-namespace:FlexMold.MVVM.ViewModel.SplashScreen"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <splashscreen:FoeViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="270" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ScrollViewer
            Margin="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <spc:FoeGridView />
        </ScrollViewer>
        <Grid Grid.Row="1">
            <Grid.Resources />
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="File Path" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="4">
                <TextBox.Text>
                    <Binding Path="Foe_sPathName">
                        <Binding.ValidationRules>
                            <core:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                Width="25"
                HorizontalAlignment="Right"
                Command="{Binding BrowseFirmwareCommand}"
                Content=".." />
            <Label
                Grid.Row="0"
                Grid.Column="3"
                HorizontalAlignment="Right"
                Content="Password" />
            <TextBox
                Name="pbox_pwd"
                Grid.Row="0"
                Grid.Column="4"
                mah:TextBoxHelper.ClearTextButton="True">
                <TextBox.Text>
                    <Binding Path="Foe_dwPass">
                        <Binding.ValidationRules>
                            <core:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <Button
                Grid.Row="1"
                Grid.ColumnSpan="5"
                Command="{Binding UpdateFirmwareCommand}"
                IsDefault="True"
                IsEnabled="{Binding BT_FirmwareEnable}">
                <Button.CommandParameter>
                    <system:Boolean>True</system:Boolean>
                </Button.CommandParameter>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Margin="6" Kind="ContentSave" />
                    <TextBlock VerticalAlignment="Center" Text="Update Firmware" />
                </StackPanel>
            </Button>
            <Grid Grid.Row="3" Grid.ColumnSpan="5">
                <mah:MetroProgressBar Value="{Binding OverAllProgress}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="{Binding DeviceStatusIndex}"
                    TextAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>

</UserControl>
