<mah:MetroWindow  x:Class="FlexMold.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:FlexMold"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">0 5 0 0</Thickness>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Home">
                <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Unit">
                        <StackPanel Orientation="Vertical">
                            <StackPanel.Resources>
                                <!--A Style that affects all TextBlocks-->
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="60"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button Content="Motor Status"  ></Button>
                            <Button Content="Sytem Status" ></Button>
                            <Button Content="Motor Status"  ></Button>
                            <Button Content="Vcauum Status" ></Button>
                            <Button Content="Heater Status" ></Button>
                            <Button Content="Laser Status"  ></Button>
                            <Button Content="Motor Status" ></Button>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Status"></GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Projects">
                    <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox  Header="Projects Selection" Grid.Column="0">
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="10" Orientation="Vertical">
                                <Button Content="Browse Projects" Width="150" 
                                Margin="{StaticResource ControlMargin}" ></Button>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Projects : "  Margin="{StaticResource ControlMargin}"></Label>
                                    <ComboBox Width="150"  Margin="{StaticResource ControlMargin}"></ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Panels : "  Margin="{StaticResource ControlMargin}"></Label>
                                    <ComboBox Width="150"  Margin="{StaticResource ControlMargin}"></ComboBox>
                                </StackPanel>

                                <GroupBox Name="datagb" Header="Available Projects" Grid.Column="0"  Margin="2,0,-2,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TreeView>
                                            <TreeViewItem Header="Cold Drinks">
                                                <TreeViewItem Header="Iced Tea"></TreeViewItem>
                                                <TreeViewItem Header="Mango Shake"></TreeViewItem>
                                            </TreeViewItem>
                                            <TreeViewItem Header="Cold Drinks">
                                                <TreeViewItem Header="Iced Tea"></TreeViewItem>
                                                <TreeViewItem Header="Mango Shake"></TreeViewItem>
                                            </TreeViewItem>
                                        </TreeView>
                                    </ScrollViewer>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Orientation="Vertical" Grid.Column="1">
                            <GroupBox  Header="Available Panels" Grid.Column="0">
                                <ScrollViewer>
                                    <TreeView>
                                        <TreeViewItem Header="Cold Drinks">
                                            <TreeViewItem Header="Coke"></TreeViewItem>
                                            <TreeViewItem Header="Pepsi"></TreeViewItem>
                                            <TreeViewItem Header="Orange Juice"></TreeViewItem>

                                        </TreeViewItem>
                                        <TreeViewItem Header="Cold Drinks">
                                            <TreeViewItem Header="Coke"></TreeViewItem>
                                            <TreeViewItem Header="Pepsi"></TreeViewItem>
                                            <TreeViewItem Header="Orange Juice"></TreeViewItem>

                                        </TreeViewItem>
                                    </TreeView>
                                </ScrollViewer>

                            </GroupBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical">
                            <GroupBox Header="Motor Sensor Info">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Selected Config : "></Label>
                                        <Label Content="Project_Panel_File"></Label>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Motor Max Travel :" ></Label>
                                        <Label Content="2m"></Label>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Travel time : "></Label>
                                        <mah:TimePicker></mah:TimePicker>
                                        <Button Content="Set"></Button>
                                    </StackPanel>

                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Motor Sensor Controls">
                                <StackPanel>
                                    <Button Content="Shape A" ></Button>
                                    <Button Content="Shape B" ></Button>
                                    <Button Content="Home" ></Button>
                                    <Button Content="Stop" ></Button>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                    </Grid>
                </TabItem>
                <TabItem Header="Setting">
                <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Unit">
                        <StackPanel Orientation="Vertical">
                            <StackPanel.Resources>
                                <!--A Style that affects all TextBlocks-->
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="60"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button Content="Machine"  ></Button>
                            <Button Content="Power" ></Button>
                            <Button Content="Motor"  ></Button>
                            <Button Content="Vcauum" ></Button>
                            <Button Content="Heater" ></Button>
                            <Button Content="Laser"  ></Button>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Parameters">

                    </GroupBox>
                </Grid>
                    
            </TabItem>
                <TabItem Header="Accessories">
                    <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="11*"/>
                            <ColumnDefinition Width="500*"/>
                        </Grid.ColumnDefinitions>

                    </Grid>
                </TabItem>
               
            </TabControl>



        </Grid>
</mah:MetroWindow>
