<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN" Id="{059d91f6-0d84-4753-89d3-b6be4ff2db71}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	motorStatus : STRING[30] := 'Running';
	dir : BYTE := 1;
	speed : WORD := 100;
	dummyData AT %Q*: DWORD := SHL(dir,2*8) OR speed ;
	rawAngle AT %I*: DWORD;
	angle: REAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[dummyData := SHL(dir,2*8) OR speed ;
angle := (rawAngle/100.0) - 180;]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="14" Count="0" />
      <LineId Id="13" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>